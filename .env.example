# Server-only. Set these in Vercel Settings > Environment Variables (Production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# At least 16 characters. Do not reuse the local browser password.
BLOG_ADMIN_PASSWORD=

# Pelis only needs this server-only TMDB v3 API key. No Google keys required.
TMDB_API_KEY=

# Google Places (New): private server key. Never use it in browser scripts.
GOOGLE_MAPS_API_KEY=
# Separate PUBLIC Maps JavaScript key, restricted by HTTP referrer and API.
GOOGLE_MAPS_BROWSER_KEY=
# Optional Google Maps map ID.
GOOGLE_MAPS_MAP_ID=
# Random secret used to sign short-lived selected-restaurant photo tokens.
RESTAURANT_PHOTO_SIGNING_SECRET=
RESTAURANTS_ENABLED=true
# Google Places content caching requires permission under your licence.
# Default stores only place IDs by zone; the active list stays in page memory.
PLACES_CACHE_CONTENT_ALLOWED=false
PLACES_CACHE_TTL_SECONDS=86400
PLACES_IDS_TTL_SECONDS=86400
# Shared enforcement across serverless instances requires the Redis vars above.
RESTAURANTS_REQUESTS_PER_10_MINUTES=20
RESTAURANTS_PHOTOS_PER_10_MINUTES=30
RESTAURANTS_SEARCH_DAILY_LIMIT=100
RESTAURANTS_SEARCH_MONTHLY_LIMIT=1000
RESTAURANTS_PHOTO_DAILY_LIMIT=100
RESTAURANTS_PHOTO_MONTHLY_LIMIT=1000
RESTAURANTS_UPSTREAM_TIMEOUT_MS=8000

